PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
TRIAL_DAYS=14
ADMIN_PASSWORD=change_this_admin_password

# رابط الواجهة (يُستخدم في بناء رابط "نسيت كلمة المرور")
FRONTEND_URL=http://localhost:5173

# اختياري: بريد SMTP لإرسال رابط إعادة تعيين كلمة المرور فعليًا.
# إذا تُركت فارغة، سيظهر الرابط مباشرة في الواجهة بدلاً من إرساله بالبريد (وضع محلي/تجريبي).
# عند التفعيل، ثبّت الحزمة أولاً: npm install nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
